# ================================================
# 龙虾道具交易平台 - 环境变量配置（开发环境）
# 复制到 C:\Users\Administrator\.openclaw\workspace\projects\龙虾道具交易平台\code\lobster-trade-server\.env
# 或在系统环境变量中设置
# ================================================

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lobster_trade
DB_USERNAME=root
DB_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=lobster-trade-jwt-secret-key-2024-dev-only
JWT_EXPIRE=86400000

# 支付配置
PAYMENT_SECRET=lobster-trade-payment-secret-dev

# 支付宝
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=http://localhost:8080/api/payment/alipay/notify
ALIPAY_RETURN_URL=http://localhost:5174/payment/result
ALIPAY_SANDBOX=true

# 微信支付
WECHAT_ENABLED=false
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_PRIVATE_KEY=
WECHAT_API_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_NOTIFY_URL=http://localhost:8080/api/payment/wechat/notify

# 服务端口
SERVER_PORT=8080

# 日志级别
LOG_LEVEL=debug

# 上传路径
UPLOAD_PATH=D:/uploads/lobster
UPLOAD_BASE_URL=http://localhost:8080/uploads